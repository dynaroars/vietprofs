{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vietprofs-stats-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-01",
  // vietprofs-stats-api.nguyenthanhvuh.workers.dev serves only /api/health, for the stats-health GitHub Action:
  // the roars.dev zone challenges GitHub's runners before a request reaches the Worker.
  "workers_dev": true,
  "preview_urls": false,
  "account_id": "16b8b7083e5362d3fb5fe759d501b174",
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "16b8b7083e5362d3fb5fe759d501b174",
    "CLOUDFLARE_ZONE_ID": "793e25e750ab903f3e9eb8edc8ac2b2e",
    "CLOUDFLARE_HOSTNAME": "vietprofs.roars.dev"
  },
  "kv_namespaces": [
    {
      "binding": "STATS_KV",
      "id": "c511a53525e04139b8dc23a2867eb1e4"
    }
  ],
  "triggers": {
    "crons": ["15 1 * * *"]
  },
  "routes": [
    {
      "pattern": "vietprofs.roars.dev/api/*",
      "zone_name": "roars.dev"
    },
    {
      "pattern": "cspicks.roars.dev/api/*",
      "zone_name": "roars.dev"
    }
  ],
  "observability": {
    "enabled": true
  }
}

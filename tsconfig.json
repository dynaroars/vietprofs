{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/data.ts",
    "src/utils.ts",
    "src/state-grid.ts",
    "scripts/validate-data.ts",
    "src/vite-env.d.ts"
  ]
}

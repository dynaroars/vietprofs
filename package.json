{
  "name": "vietacademia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A directory of Vietnamese professors worldwide.",
  "scripts": {
    "dev": "vite",
    "predev": "npm run assign-profile-ids && tsx scripts/generate-profile-pages.ts --dev",
    "prebuild": "npm run assign-profile-ids && cp paper.pdf public/paper.pdf",
    "build": "vite build && tsx scripts/generate-profile-pages.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate-data": "tsx scripts/validate-data.ts",
    "prevalidate-data": "npm run assign-profile-ids",
    "assign-profile-ids": "tsx scripts/assign-profile-ids.ts",
    "test": "npm run validate-data && tsx --test test/data.test.ts test/maintenance-controller.test.ts test/profile-pages.test.ts test/ui.test.ts",
    "test:e2e": "npm run build && tsx --test test/browser-smoke.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}

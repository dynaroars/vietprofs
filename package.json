{
  "name": "vietacademia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A directory of Vietnamese professors worldwide.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run assign-profile-ids && npm run sync-profile-css && tsx scripts/generate-profile-pages.ts --dev",
    "prebuild": "npm run assign-profile-ids && npm run sync-profile-css",
    "build": "vite build && tsx scripts/generate-profile-pages.ts && tsx scripts/slim-public-data.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "analyze": "tsx scripts/analyze-roster.ts",
    "figures": "npm run build && tsx scripts/capture-figures.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "check-links": "tsx scripts/check-links.ts",
    "prevalidate-data": "npm run assign-profile-ids",
    "assign-profile-ids": "tsx scripts/assign-profile-ids.ts",
    "retire-profile-id": "tsx scripts/retire-profile-id.ts",
    "harvest-websites": "tsx scripts/harvest-websites.ts",
    "find-roster-matches": "tsx scripts/find-roster-matches.ts",
    "stamp-updates": "tsx scripts/stamp-updates.ts",
    "sync-profile-css": "tsx scripts/sync-profile-css.ts",
    "pretest": "npm run stamp-updates && npm run sync-profile-css",
    "test": "npm run validate-data && npm run typecheck && tsx --test 'test/*.test.ts'",
    "lint": "biome lint src scripts test",
    "test:e2e": "npm run build && tsx --test test/browser-smoke.e2e.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}

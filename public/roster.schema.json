{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VietProfs Roster Schema",
  "description": "Schema for the Vietnamese and diaspora faculty roster (public/data.json)",
  "type": "array",
  "minItems": 0,
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "profileUrl",
      "university",
      "city",
      "department",
      "track",
      "researchAreas"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^vp-[0-9]{4,}$",
        "description": "Immutable zero-padded 4-digit unique identifier"
      },
      "name": {
        "$ref": "#/$defs/nonEmptyString",
        "description": "Full name in Latin/Western format (Given-name-first)"
      },
      "vietnameseName": {
        "type": "string",
        "description": "Authoritative native name with Vietnamese diacritics (Surname-first)"
      },
      "university": {
        "$ref": "#/$defs/nonEmptyString",
        "description": "Canonical institution name"
      },
      "institutionType": {
        "enum": [
          "University",
          "Public research institute",
          "Independent nonprofit research institute",
          "Corporate research lab",
          "Policy & international organization",
          "Think tank",
          "Government & defense",
          "National laboratory"
        ],
        "description": "Omitted for a university; otherwise the kind of research institute"
      },
      "city": {
        "$ref": "#/$defs/nonEmptyString",
        "description": "City of primary campus / appointment"
      },
      "state": {
        "type": "string",
        "description": "US state or regional province"
      },
      "country": {
        "type": "string",
        "description": "Country of institution"
      },
      "department": {
        "$ref": "#/$defs/nonEmptyString",
        "description": "Academic department, school, division, or laboratory"
      },
      "rank": {
        "type": "string",
        "enum": [
          "Assistant Professor",
          "Associate Professor",
          "Professor",
          "Lecturer",
          "Senior Lecturer",
          "Researcher",
          "Librarian",
          "Administrator"
        ],
        "description": "Career level; the track says Clinical/Teaching/Research. Omit when unknown."
      },
      "track": {
        "type": "string",
        "enum": [
          "Tenure-line",
          "Teaching",
          "Research",
          "Clinical",
          "Admin and Staff",
          "Emeritus",
          "Deceased",
          "Industry Research",
          "Policy & Think Tank",
          "Government & Defense"
        ],
        "description": "Appointment track"
      },
      "confirmed": {
        "description": "Present only for an unconfirmed record (no official current profile); omit when confirmed.",
        "const": false,
        "type": "boolean"
      },
      "researchAreas": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        },
        "description": "Primary scholarly fields and research topics"
      },
      "profileUrl": {
        "$ref": "#/$defs/httpUrl",
        "description": "Official university faculty profile or directory link"
      },
      "websiteUrl": {
        "$ref": "#/$defs/httpUrl",
        "description": "Personal homepage, or the lab site when there is none"
      },
      "scholarUrl": {
        "type": "string",
        "description": "Google Scholar citation profile URL"
      },
      "linkedinUrl": {
        "type": "string",
        "description": "LinkedIn personal profile URL"
      },
      "portrait": {
        "type": "string",
        "pattern": "^portraits/[a-z0-9][a-z0-9.-]*\\.webp$",
        "description": "Relative path to optimized WebP portrait file"
      },
      "portraitSource": {
        "$ref": "#/$defs/httpUrl",
        "description": "Public source URL where portrait was obtained"
      },
      "postdocInstitution": {
        "$ref": "#/$defs/nonEmptyString",
        "description": "Postdoctoral training institution"
      },
      "undergradInstitution": {
        "$ref": "#/$defs/nonEmptyString",
        "description": "Undergraduate alma mater"
      },
      "undergradYear": {
        "$ref": "#/$defs/year",
        "description": "Undergraduate graduation year"
      },
      "msInstitution": {
        "$ref": "#/$defs/nonEmptyString",
        "description": "Master's degree institution"
      },
      "phdInstitution": {
        "$ref": "#/$defs/nonEmptyString",
        "description": "PhD / Doctoral degree institution"
      },
      "phdYear": {
        "$ref": "#/$defs/year",
        "description": "PhD completion year"
      },
      "mdInstitution": {
        "$ref": "#/$defs/nonEmptyString",
        "description": "Medical degree institution"
      },
      "honors": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "organization",
            "category",
            "year",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "organization": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "category": {
              "enum": [
                "academy",
                "fellow",
                "career_award",
                "major_award",
                "distinguished_professorship"
              ]
            },
            "year": {
              "description": "null when the year is unknown",
              "anyOf": [
                {
                  "$ref": "#/$defs/year"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "description": "Honors, awards, academy memberships, and chair appointments"
      },
      "directFields": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "honors",
            "name",
            "portrait",
            "portraitSource",
            "vietnameseName"
          ]
        },
        "description": "Protected fields set by an owner or submitted direct update (sorted)"
      }
    },
    "additionalProperties": false,
    "dependentRequired": {
      "portrait": [
        "portraitSource"
      ],
      "portraitSource": [
        "portrait"
      ]
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "httpUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "year": {
      "type": "integer",
      "minimum": 1900
    }
  }
}
